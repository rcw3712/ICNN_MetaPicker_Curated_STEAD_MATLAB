      "descriptions": [
        {
          "lang": null,
          "description": "Location: N-S swath along 13.35\u00b0E from Eastern Bavaria to the Adriatic See",
          "descriptionType": "Other"
        },
        {
          "lang": null,
          "description": "The project aims to investigate the origin of the slab beneath the Eastern Alps (European? Adriatic?), to perform tomographic calculations, the characterize the fabric of the lower crust, compute receiver functions at the crustal and lithospheric scale, to investigate the previously reported Moho gap, and to map the relationship of the Alpine orogen with the adjacent basins and lithospheric blocks.",
